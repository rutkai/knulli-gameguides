{
  "actions_player1": [
    {
      "trigger": ["hotkey", "select"],
      "type": "exec",
      "target": "setsid /userdata/system/gameguide/gameguide-launch.sh </dev/null >/dev/null 2>&1 &",
      "description": "MENU + SELECT: open the text guide for the running game. Change it with: gameguide.py --set-hotkey auto"
    }
  ]
}
